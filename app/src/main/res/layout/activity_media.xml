<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.media.MediaActivity"
    android:background="?attr/colorPrimary"
    android:orientation="vertical"
    android:theme="@style/Base.Theme.PlaylistMaker">
    <Button
        style = "@style/top_button"
        app:iconGravity = "textStart"
        android:text="@string/media_library"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="@dimen/avrg_text_size"
        app:icon = "@drawable/arrowback"
        app:iconPadding = "@dimen/low_margin"
        android:layout_marginBottom="0dp"
        android:id="@+id/home"
        android:layout_height="56dp"
        app:iconTint="?attr/colorOnPrimary"
        />
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:tabTextColor="?attr/colorOnPrimary"
        android:backgroundTint="?attr/colorPrimary"
        app:tabIndicatorColor="?attr/colorOnPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabTextAppearance="@style/TabTextStyle"

        />
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>